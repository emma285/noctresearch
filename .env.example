# Notion Integration
# 1. https://www.notion.so/my-integrations 에서 새 통합 생성
# 2. 생성된 API 키를 아래에 입력
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx

# Notion Database ID
# 1. Notion에서 데이터베이스 생성 (아래 README 참고)
# 2. 데이터베이스 URL에서 ID 추출
# 예: https://notion.so/myworkspace/abc123def456... → abc123def456...
NOTION_DATABASE_ID=3c039b6567564d68b7dfff6384ee330c
